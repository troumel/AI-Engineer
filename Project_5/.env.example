APP_NAME=Multi-Modal AI API
APP_VERSION=1.0.0
ENVIRONMENT=development

API_HOST=0.0.0.0
API_PORT=8004
LOG_LEVEL=INFO

DATA_DIRECTORY=data
IMAGES_DIRECTORY=data/images
METADATA_FILE=data/images/metadata.json
MAX_UPLOAD_BYTES=10485760
EMBEDDING_DIMENSIONS=64

# Set to "huggingface" to use BLIP / CLIP when transformers + torch are installed.
# Default "hashing" works offline and is fully deterministic.
VISION_PROVIDER=hashing
CAPTION_MODEL=Salesforce/blip-image-captioning-base
CLIP_MODEL=openai/clip-vit-base-patch32
