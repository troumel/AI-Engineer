APP_NAME=Custom LLM Inference API
APP_VERSION=1.0.0
ENVIRONMENT=development

API_HOST=0.0.0.0
API_PORT=8007
LOG_LEVEL=INFO

DATA_DIRECTORY=data
USAGE_FILE=data/usage.json

# "echo" runs fully offline. Set to "vllm", "transformers", or "llamacpp" for production.
LLM_BACKEND=echo
DEFAULT_MODEL=phi-3-mini-offline

# Inference / batching
MAX_BATCH_SIZE=8
MAX_QUEUE_DEPTH=64
BATCH_TIMEOUT_MS=20
MAX_OUTPUT_TOKENS=256

# Rate limiting (token bucket per API key)
RATE_LIMIT_TOKENS_PER_MINUTE=60000
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# Usage tracking
COST_PER_1K_PROMPT_TOKENS=0.0005
COST_PER_1K_COMPLETION_TOKENS=0.0015

# Auth — comma-separated api keys; empty disables auth
API_KEYS=
