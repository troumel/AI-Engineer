APP_NAME=AI Agent API
APP_VERSION=1.0.0
ENVIRONMENT=development

API_HOST=0.0.0.0
API_PORT=8005
LOG_LEVEL=INFO

# "rule_based" runs offline. Set to "openai" or "anthropic" to use real
# function-calling LLMs (requires the optional clients + API keys).
PLANNER_BACKEND=rule_based
MAX_AGENT_ITERATIONS=6

DATA_DIRECTORY=data
CONVERSATIONS_FILE=data/conversations.json
SQLITE_DATABASE=data/agent.db

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
