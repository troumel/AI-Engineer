APP_NAME=Advanced RAG API
APP_VERSION=1.0.0
ENVIRONMENT=development

API_HOST=0.0.0.0
API_PORT=8006
LOG_LEVEL=INFO

DATA_DIRECTORY=data
STORAGE_FILE=data/corpus.json

EMBEDDING_DIMENSIONS=128
CHUNK_SIZE=400
CHUNK_OVERLAP=80

BM25_K1=1.5
BM25_B=0.75
RRF_K=60
RERANKER_ENABLED=true

# "rule_based" works offline. Set to "openai" for production answer generation.
ANSWER_BACKEND=rule_based
OPENAI_API_KEY=
